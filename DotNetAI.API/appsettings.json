{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Gemini",
    "MaxOutputTokens": 400,
    "Temperature": 0.3
  },
  "Gemini": {
    "Model": "gemini-2.5-flash",
    "EmbeddingModel": "gemini-embedding-001"
  },
  "OpenAI": {
    "Model": "gpt-4o-mini"
  },
  "Knowledge": {
    "DocumentsPath": "Knowledge",
    "ChunkSize": 2000,
    "ChunkOverlap": 80,
    "EmbeddingDelayMilliseconds": 4000,
    "MaxUploadBytes": 2097152,
    "RagTopK": 3,
    "MinimumSimilarityScore": 0.45
  }
}
