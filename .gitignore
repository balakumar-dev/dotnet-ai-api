## Ignore Visual Studio temporary files, build results, and
## files generated by popular .NET tools.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates

# Rider / VS Code
.idea/
.vscode/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# User secrets must never be committed. They live outside the repo,
# but keep this as a safety net if anyone copies secrets locally.
secrets.json
appsettings.*.local.json

# OS
Thumbs.db
Desktop.ini
.DS_Store
